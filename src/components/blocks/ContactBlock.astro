---
// A contact form, delivered through Pirate Forms (github.com/piratewebsite/pirate-forms).
// Messages go to the Contact Form Email in Site Settings. The address is sealed at build
// time, so it never appears in the page, and it receives nothing until its owner has
// confirmed by email. (A site registered by the network operator can use a Contact Form ID
// instead.) With neither setting the block renders nothing, so it is harmless to add early.
import { Form, isEmailAddress } from 'pirate-forms';
import settings from '../../content/settings.json';

const {
  heading,
  description,
  layout = 'narrow',
  showName = true,
  showPhone = false,
  submitLabel = 'Send Message',
  successMessage = 'Thanks! Your message was sent.',
} = Astro.props;

const contactEmail = String((settings as any).contactEmail || '').trim();
const formId = String((settings as any).pirateFormsId || '').trim();
// A mistyped address must not break the whole site build: the form is left out instead.
const recipient = contactEmail.startsWith('v1.') || isEmailAddress(contactEmail) ? contactEmail : '';
const target = recipient ? { recipient } : formId ? { id: formId } : null;
const wrapperClass = layout === 'full' ? '' : 'max-w-3xl mx-auto';
const fields = [
  showName && { name: 'name', label: 'Your Name' },
  { name: 'email', type: 'email', label: 'Your Email', required: true },
  showPhone && { name: 'phone', type: 'tel', label: 'Your Phone' },
  { name: 'message', type: 'textarea', label: 'Message', required: true, rows: 6 },
].filter(Boolean) as any[];

if (contactEmail && !recipient) console.warn(`[ContactBlock] The Contact Form Email in Site Settings is not an email address; ${target ? 'using the Contact Form ID instead' : 'the contact form block is hidden'}.`);
else if (!target) console.warn('[ContactBlock] No Contact Form Email in Site Settings; the contact form block is hidden.');
---

{target && (
  <section class={`mb-12 ${wrapperClass}`}>
    {heading && <h2 class="mb-2 text-xl font-semibold">{heading}</h2>}
    {description && <p class="mb-6 text-theme-muted">{description}</p>}
    <Form
      {...target}
      fields={fields}
      submitLabel={submitLabel}
      successMessage={successMessage}
      submitClass="inline-flex cursor-pointer items-center rounded-md bg-theme-primary px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90 disabled:opacity-60"
      class="ps-contact"
    />
  </section>
)}

<style>
  /* The form takes its colours from the site theme. */
  .ps-contact {
    --pf-accent: var(--ps-primary);
    --pf-border: var(--ps-input-border);
    --pf-bg: var(--ps-input-bg);
  }
</style>
